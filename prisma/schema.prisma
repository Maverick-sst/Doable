// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DISCOVERY
  PENDING
  IN_PROGRESS
  IDLE
  INCOMPLETE
  FAILED
}

enum MessagePhase {
  DISCOVERY
  BUILD
}

enum Role {
  USER
  ASSISTANT
}

enum EmbeddingStatus {
  EMBEDDING_PENDING
  EMBEDDING_PROCESSING
  EMBEDDING_SUCCESSFUL
  EMBEDDING_RETRYING
  EMBEDDING_FAILED
}

enum WorkflowType {
  DISCOVERY
  HCR
  VERIFICATION
  REPAIR
}

enum WorkflowStatus {
  CREATED
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionStatus {
  CREATED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum NodeType {
  DISCOVERY
  ARCHITECT
  RESEARCH
  PRD_REVIEWER
  PLANNER
  FRONTEND_ENG
  BACKEND_ENG
  WORKER
  TEST_DESIGNER
  QA
  REPAIR
}

enum ArtifactType {
  DISCOVERY_REQUIREMENT
  ARCHITECTURE_SPEC
  RESEARCH_DOSSIER
  APPROVED_PRD
  EXECUTION_PLAN
  VERIFICATION_REPORT
}

enum ToolCallStatus {
  STARTED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum VerificationStatus {
  NOT_RUN
  RUNNING
  PASSED
  FAILED
  TIMED_OUT
  BLOCKED
}

enum NodeStatus {
  CREATED
  RUNNING
  COMPLETED
  INCOMPLETE
  FAILED
  SKIPPED
}

enum ProjectDomain {
  FULL_STACK_APPLICATION
  LANDING_PAGE
}

model Message {
  id          String       @id @default(cuid())
  role        Role
  content     String       @db.Text
  createdAt   DateTime     @default(now())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       MessagePhase @default(BUILD)
  workflowId  String?
  executionId String?

  @@index([projectId, phase, createdAt])
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]
  memoryEntries MemoryEntry[]
}

model Project {
  id            String         @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  status        ProjectStatus  @default(DISCOVERY)
  failureReason String?        @db.Text
  archivedAt    DateTime?
  workspacePath String?
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  files         File[]
  messages      Message[]
  workflows     Workflow[]
  memory        ProjectMemory?
  artifacts     Artifact[]
  verifications VerificationReport[]
  memoryEntries MemoryEntry[]

  @@index([userId, status])
}

model File {
  id              String          @id @default(cuid())
  path            String
  content         String          @db.Text
  checksum        String?
  revision        Int             @default(1)
  size            Int?
  mimeType        String?
  /// Idempotency key of the tool call that produced this file.
  toolCallKey     String?         @unique
  embedding       Unsupported("vector(768)")?
  embeddingStatus EmbeddingStatus @default(EMBEDDING_PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId, updatedAt])
}

model Workflow {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       WorkflowType
  status     WorkflowStatus @default(CREATED)
  executions Execution[]
  artifacts  Artifact[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Execution {
  id                 String          @id @default(cuid())
  workflowId         String
  workflow           Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status             ExecutionStatus @default(CREATED)
  retryCount         Int             @default(0)
  /// Attempt number within one build. Attempt 1 is the original run.
  attempt            Int             @default(1)
  /// The attempt this one resumes from, when it is a resume.
  parentExecutionId  String?
  parentExecution    Execution?      @relation("ExecutionAttempts", fields: [parentExecutionId], references: [id], onDelete: SetNull)
  childExecutions    Execution[]     @relation("ExecutionAttempts")
  /// Node type this attempt resumed at, for audit.
  resumedFromNodeType NodeType?
  /// COMPLETE, PARTIAL, or FAILED — distinct from the transport status.
  completionStatus   String          @default("COMPLETE")
  temporalWorkflowId String?
  temporalRunId      String?
  startedAt          DateTime?
  finishedAt         DateTime?
  failureReason      String?         @db.Text
  nodes              Node[]
  events             RuntimeEvent[]
  artifacts          Artifact[]
  toolCalls          ToolCall[]
  verifications      VerificationReport[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status, updatedAt])
  @@index([parentExecutionId])
}

model Node {
  id            String         @id @default(cuid())
  executionId   String
  execution     Execution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  parentNodeId  String?
  parentNode    Node?          @relation("NodeWorkers", fields: [parentNodeId], references: [id])
  childNode     Node[]         @relation("NodeWorkers")
  type          NodeType
  status        NodeStatus     @default(CREATED)
  order         Int
  attempt       Int            @default(0)
  /// Version of the agent configuration used for this node.
  agentConfigVersion String?
  /// Hash of the agent configuration, for exact reproduction.
  agentConfigHash String?
  startedAt     DateTime?
  finishedAt    DateTime?
  failureReason String?        @db.Text
  events        RuntimeEvent[]
  artifacts     Artifact[]
  toolCalls     ToolCall[]
  verifications VerificationReport[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([executionId, order, type])
  @@index([executionId, status])
}

model Artifact {
  id               String      @id @default(cuid())
  projectId        String
  workflowId       String
  executionId      String?
  nodeId           String?     @unique
  type             ArtifactType
  version          Int
  schemaVersion    Int         @default(1)
  validationStatus String      @default("VALID")
  contentHash      String?
  producedBy       NodeType
  content          Json
  metadata         Json?
  parentArtifactId String?
  parentArtifact   Artifact?   @relation("ArtifactVersions", fields: [parentArtifactId], references: [id])
  childArtifacts   Artifact[]  @relation("ArtifactVersions")
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow         Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  execution        Execution?  @relation(fields: [executionId], references: [id], onDelete: SetNull)
  node             Node?       @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())

  @@unique([projectId, type, version])
  @@index([projectId, type, createdAt])
}

model RuntimeEvent {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String?
  node        Node?     @relation(fields: [nodeId], references: [id])
  type        String
  payload     Json?
  createdAt   DateTime  @default(now())
}

model ProjectMemory {
  id           String        @id @default(cuid())
  projectId    String        @unique
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain       ProjectDomain
  requirements Json
  techStack    Json
  summary      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ToolCall {
  id              String          @id @default(cuid())
  executionId     String
  execution       Execution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId          String?
  node            Node?           @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  /// Stable key derived from execution, node, turn, tool and argument hash.
  idempotencyKey  String          @unique
  tool            String
  toolVersion     String?
  argumentsHash   String
  status          ToolCallStatus  @default(STARTED)
  result          String?         @db.Text
  errorCode       String?
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([executionId, nodeId])
}

model VerificationReport {
  id          String             @id @default(cuid())
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executionId String?
  execution   Execution?         @relation(fields: [executionId], references: [id], onDelete: SetNull)
  nodeId      String?
  node        Node?              @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  status      VerificationStatus @default(NOT_RUN)
  command     String?            @db.Text
  exitCode    Int?
  durationMs  Int?
  output      String?            @db.Text
  revision    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([projectId, createdAt])
}


enum MemoryKind {
  WORKING
  EPISODIC
  SEMANTIC
  PROCEDURAL
  PREFERENCE
}

enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  DELETED
}

enum MemoryScope {
  PROJECT
  USER
}

/// Layered memory (D4). Working memory stays ephemeral in context-engine
/// scratchpad/tool history; this table stores episodic, semantic, procedural,
/// and preference memory with provenance, supersession, and retention.
model MemoryEntry {
  id              String          @id @default(cuid())
  scope           MemoryScope     @default(PROJECT)
  kind            MemoryKind
  status          MemoryStatus    @default(ACTIVE)
  /// Logical slot this entry fills, e.g. "summary" or "tech-stack:frontend".
  /// A newer entry for the same subject supersedes the active one.
  subject         String
  content         String          @db.Text
  data            Json?
  confidence      Float           @default(1)
  /// Provenance: which durable object produced this memory.
  sourceKind      String
  sourceId        String?
  sourceRefs      Json?
  contentHash     String
  /// Idempotency: scope + owner + kind + subject + content hash.
  contentKey      String          @unique
  supersededById  String?
  supersededAt    DateTime?
  deletedAt       DateTime?
  deletionReason  String?
  expiresAt       DateTime?
  embedding       Unsupported("vector(768)")?
  embeddingStatus EmbeddingStatus @default(EMBEDDING_PENDING)
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([projectId, kind, status])
  @@index([projectId, subject, status])
  @@index([userId, kind, status])
  @@index([expiresAt, status])
}

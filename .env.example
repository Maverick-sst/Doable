# ── Local-first defaults ────────────────────────────────────────────────
# Copy to .env and adjust. The app binds to 127.0.0.1 by default.
AUTH_MODE=local
DATABASE_DRIVER=pg
DATABASE_URL=postgresql://doable:doable@127.0.0.1:5432/doable
DOABLE_HOME=./.doable
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# ── Temporal ────────────────────────────────────────────────────────────
TEMPORAL_HOST=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pilot-queue
TEMPORAL_TLS=false
# TEMPORAL_API_KEY=

# ── Model provider ──────────────────────────────────────────────────────
# "ollama" for a local model, or "openrouter" for a selected open-weight
# remote model. Local is the default when OLLAMA_BASE_URL is set.
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Remote option (only used when MODEL_PROVIDER=openrouter)
# OPENROUTER_API_KEY=
# MODEL=
# EMBEDDING_MODEL=

# RunAnywhere (OpenAI-compatible, chat/tools only; no embeddings endpoint)
# RUNANYWHERE_API_KEY=
# RUNANYWHERE_BASE_URL=https://inference.runanywhere.ai/v1
# MODEL=glm-5.3-flash

# ── Model routing, egress, and usage (D5) ───────────────────────────────
# Fail closed: when true, no remote provider is ever selected, even if it is
# the explicit MODEL_PROVIDER. An environment with no reachable local endpoint
# reports "No eligible model" instead of falling back to remote.
MODEL_LOCAL_ONLY=false
# Per-task-profile model ids ("provider:model"). Empty uses the default
# provider and model. Profiles: reasoning, planning, implementation.
# MODEL_ROUTING_REASONING=ollama:llama3.2
# MODEL_ROUTING_PLANNING=ollama:llama3.2
# MODEL_ROUTING_IMPLEMENTATION=ollama:llama3.2
# Comma-separated ordered fallbacks, e.g. "ollama:llama3.2,runanywhere:glm-5.3-flash"
# MODEL_FALLBACKS=
# Context-window declarations. A wrong value is a routing input error, not a
# provider error, so keep these aligned with the selected models.
# MODEL_CONTEXT_WINDOW=
# OLLAMA_CONTEXT_WINDOW=32768
# OPENROUTER_CONTEXT_WINDOW=128000
# RUNANYWHERE_CONTEXT_WINDOW=128000
MODEL_MAX_OUTPUT_TOKENS=8192
# Optional per-call output reservation; defaults to the model's max output.
# MODEL_REQUIRED_OUTPUT_TOKENS=
MODEL_CONTEXT_SAFETY_TOKENS=2048
# Retries and per-process circuit breaker.
MODEL_MAX_ATTEMPTS=2
MODEL_RETRY_DELAY_MS=250
MODEL_CIRCUIT_FAILURES=3
MODEL_CIRCUIT_COOLDOWN_MS=60000
# Per-execution provider-reported token ceiling. 0 disables the gate.
RUN_TOKEN_BUDGET=0
# Optional flat-rate cost estimate recorded on model.usage events. This is
# telemetry, not provider billing; leave at 0 when local inference is free.
MODEL_INPUT_COST_PER_1K_USD=0
MODEL_OUTPUT_COST_PER_1K_USD=0

# Node budgets. The legacy MAX_ITERATIONS belonged to the retired monolithic
# agent loop and is intentionally not read any more.
NODE_MAX_ITERATIONS=120
NODE_WALL_CLOCK_BUDGET_MS=2700000
# Assembled-context ceiling (estimated tokens). Relevant/optional sources
# compact to fit; required sources are kept and reported as overflow.
CONTEXT_TOKEN_BUDGET=60000
# Episodic memory retention. Semantic/procedural/preference memory is
# superseded rather than expired.
MEMORY_EPISODIC_RETENTION_DAYS=90
NODE_ACTIVITY_TIMEOUT_MINUTES=30
TOOL_ACTIVITY_TIMEOUT_MINUTES=60
TEMPORAL_HEARTBEAT_TIMEOUT_MINUTES=10
HCR_WORKFLOW_TIMEOUT_HOURS=12

# ── Optional hosted mode ────────────────────────────────────────────────
# AUTH_MODE=hosted
# DATABASE_DRIVER=neon
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=
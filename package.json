{
  "name": "doable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "temporal:worker": "bun src/temporal/worker.ts",
    "temporal:hello": "bun scripts/temporal-hello.ts",
    "temporal:up": "docker compose -f docker-compose.local.yml up -d",
    "temporal:down": "docker compose -f docker-compose.local.yml down",
    "health": "bun scripts/healthcheck.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.12",
    "@modelcontextprotocol/client": "2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "dotenv": "^16.6.1",
    "fflate": "^0.8.2",
    "next": "16.2.3",
    "pg": "^8.16.3",
    "playwright-core": "^1.64.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "svix": "^1.90.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.11",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
